# Connection settings for the PaperLens backend.
# Copy this template to .env and fill in the values for your environment.

# Direct FPT Cloud retrieval: multilingual-e5-large and bge-reranker-v2-m3.
API_URL=https://mkp-api.fptcloud.com
API_KEY=
# Optional overrides; blank values use API_URL + /embeddings and /v1/rerank.
FPT_EMBEDDING_URL=
FPT_RERANK_URL=

# 9Router chat: fpt/Qwen3.8-27B, Gemini and Claude.
LLM_API_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=

# Local daily caps: -1 = unlimited, 0 = disabled, positive integer = daily cap.
# Set finite values when hosting a shared service; upstream provider quotas still apply.
DAILY_AGENT_TURNS=-1
DAILY_NEW_INDEXES=-1
DAILY_SEMANTIC_RETRIEVALS=-1

# Optional Google/GitHub sign-in. Secrets belong on the backend only.
# Register <AUTH_PUBLIC_BASE_URL>/api/v1/auth/google/callback and /github/callback.
AUTH_PUBLIC_BASE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
